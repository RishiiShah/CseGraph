{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://csegraph.dev/schemas/adaptive-benchmark-task-v1.json",
  "title": "CseGraph adaptive benchmark corpus",
  "type": "object",
  "required": [
    "schema_version",
    "corpus_version",
    "tier",
    "status",
    "repositories",
    "tasks"
  ],
  "properties": {
    "schema_version": {
      "const": "csegraph-adaptive-benchmark-v1"
    },
    "corpus_version": {"type": "string", "minLength": 1},
    "tier": {"enum": ["pr", "nightly", "release"]},
    "status": {"enum": ["ready", "planned", "blocked"]},
    "unsupported_reason": {"type": ["string", "null"]},
    "repositories": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["url", "commit"],
        "properties": {
          "url": {"type": "string", "minLength": 1},
          "commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"}
        },
        "additionalProperties": false
      }
    },
    "tasks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "repo", "commit", "category", "task"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "repo": {"type": "string", "minLength": 1},
          "commit": {"type": "string", "minLength": 7},
          "category": {
            "enum": ["definition", "ambiguous", "cross-file", "debug", "refactor"]
          },
          "task": {"type": "string", "minLength": 1},
          "target": {"type": ["string", "null"]},
          "expected_locations": {
            "type": "array",
            "items": {"type": "string"}
          },
          "permitted_files": {
            "type": "array",
            "items": {"type": "string"}
          },
          "setup_command": {
            "type": "array",
            "items": {"type": "string"}
          },
          "test_command": {
            "type": "array",
            "items": {"type": "string"}
          },
          "hidden_checks": {
            "type": "array",
            "items": {
              "oneOf": [
                {"type": "string", "minLength": 1},
                {
                  "type": "array",
                  "minItems": 1,
                  "items": {"type": "string"}
                }
              ]
            }
          },
          "execution_mode": {"enum": ["retrieval", "agent"]},
          "agent_command": {
            "type": "array",
            "items": {"type": "string"}
          },
          "timeout_seconds": {"type": "number", "exclusiveMinimum": 0},
          "supported": {"type": "boolean"},
          "unsupported_reason": {"type": ["string", "null"]},
          "network_required": {"type": "boolean"}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
